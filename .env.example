# FoundryVTT account credentials (foundryvtt.com)
# Used by the felddy/foundryvtt Docker image to download and license Foundry
FOUNDRY_USERNAME=your_foundry_username
FOUNDRY_PASSWORD=your_foundry_password
FOUNDRY_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX

# Admin password for the running FoundryVTT instance
# Used by Playwright tests to log in via the setup/join screen
FOUNDRY_ADMIN_KEY=atropos

# FoundryVTT Docker container user/group IDs
# Set these to match your host user to avoid permission issues with mounted volumes
# Run `id -u` and `id -g` to get your values
FOUNDRY_UID=1000
FOUNDRY_GID=1000
