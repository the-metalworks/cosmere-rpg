{
    "name": "cosmere-rpg",
    "version": "2.0.4",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npx rollup -c",
        "build:pack": "npm run build && npm run pack",
        "build:watch": "npx rollup -c -w",
        "build:release": "npm run build && npm run pack && npm run zip",
        "prepare": "husky",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "prettier": "prettier .",
        "prettier:write": "prettier --write .",
        "link": "node ./scripts/link-foundry",
        "pack": "node ./scripts/pack",
        "zip": "node ./scripts/zip",
        "build:test": "INCLUDE_TESTS=true npx rollup -c",
        "docker:setup-quench": "bash scripts/setup-quench.sh",
        "docker:dev": "npm run build && docker compose -f docker/docker-compose.yml up",
        "docker:dev:detach": "npm run build && docker compose -f docker/docker-compose.yml up -d",
        "docker:dev:down": "docker compose -f docker/docker-compose.yml down",
        "docker:test:up": "npm run build:test && bash scripts/seed-test-world.sh && docker compose -f docker/docker-compose.test.yml up -d --wait",
        "docker:test:down": "docker compose -f docker/docker-compose.test.yml down -v",
        "test:setup": "npx playwright install chromium",
        "test:e2e": "npx playwright test --project=chromium",
        "test:quench": "npx playwright test --project=quench",
        "test:all": "npx playwright test"
    },
    "devDependencies": {
        "@ethaks/fvtt-quench": "^0.10.0",
        "@eslint/js": "^9.9.0",
        "@foundryvtt/foundryvtt-cli": "^1.0.3",
        "@league-of-foundry-developers/foundry-vtt-types": "^13.346.0-beta.20250908011144",
        "@rollup/plugin-commonjs": "^26.0.1",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-replace": "^5.0.7",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/eslint__js": "^8.42.3",
        "@types/jquery": "^3.5.30",
        "@types/node": "^20.14.15",
        "@types/spark-md5": "^3.0.4",
        "archiver": "^7.0.1",
        "eslint": "^9.9.0",
        "husky": "^9.1.5",
        "lint-staged": "^15.2.9",
        "marked": "^14.1.3",
        "prettier": "^3.3.3",
        "prompts": "^2.4.2",
        "rollup": "^4.21.0",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-scss": "^4.0.0",
        "sass": "^1.77.8",
        "tslib": "^2.6.3",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.2.0",
        "@playwright/test": "^1.50.0"
    },
    "engines": {
        "node": "^20"
    },
    "dependencies": {
        "@pixi-essentials/svg": "^3.0.0",
        "@pixi/filter-drop-shadow": "^5.2.0",
        "@pixi/filter-glow": "^5.2.1",
        "spark-md5": "^3.0.2"
    }
}
