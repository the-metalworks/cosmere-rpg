    "system": {
        "id": "tin-allomancy",
        "type": "metallic-art",
        "description": {
            "value": "<p>Tin Allomancy allows you to powerfully enhance your senses. Though tin Allomancers are called Tineyes, burning this metal increases all your senses, not just your sight. As such, Tineyes make great guards or scouts, especially in areas of low light. </p><p>When a Tineye is experiencing pain or exhaustion, they sometimes flare tin to clear their head for a time, shocking their body with sensory input to reset it.</p>",
            "chat": "",
            "short": ""
        },
        "resources": {
            "uses": null,
            "charges": null,
            "ammo": null
        },
        "events": {},
        "relationships": {},
        "customSkill": true,
        "skill": "all",
        "talentTree": null,
        "primaryResource": "none",
