<section class="window-content standard-form">
    <p class="hint">Configure what a user with limited ownership sees on character/adversary sheets</p>
    <header class="table-header flexrow">
        <label class="index">Visibility</label>
        <label>Character</label>
        <label>Adversary</label>
    </header>
    <ul class="visibility-list">
        <li class="visibility form-group">
            <label class="index">Show Stats</label>
            <div class="form-fields">
                <input type="checkbox" name="showStatsCharacter">
                <input type="checkbox" name="showStatsAdversary">
            </div>
            <p class="hint">Let users with limited visibility see sheet's stats such as strength, speed, etc.</p>
        </li>
    </ul>
</section>