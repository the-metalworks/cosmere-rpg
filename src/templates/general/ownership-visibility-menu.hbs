{{log "root: " @root}}
<section class="window-content standard-form">
    <p class="hint">Configure what a user with limited ownership sees on character/adversary sheets</p>
    <header class="table-header flexrow">
        <label class="index">Visibility</label>
        <label>Character</label>
        <label>Adversary</label>
    </header>
    <ul class="visibility-list">
        {{#each settings as |setting|}}
        <li class="visibility form-group">
            <label class="index">{{localize setting.name}}</label>
            <div class="form-fields">
                <input type="checkbox" {{#unless setting.character.available}}disabled{{/unless}} name="showStatsCharacter" {{checked setting.character.value}}>
                <input type="checkbox" {{#unless setting.adversary.available}}disabled{{/unless}} name="showStatsAdversary" {{checked setting.adversary.value}}>
            </div>
            <p class="hint">{{localize setting.hint}}</p>
        </li>
        {{/each}}
    </ul>
</section>