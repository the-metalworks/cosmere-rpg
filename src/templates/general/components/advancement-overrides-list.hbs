<div>
    <ul class="item-list">
        <li class="item header">
            <section class="details">
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Levels.Label"}}</span>
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Type"}}</span>
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Mode"}}</span>
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Key"}}</span>
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Stat"}}</span>
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Value"}}</span>
                <span class="subtitle">{{localize "COSMERE.Advancement.Override.Data.Priority"}}</span>
                <div class="controls icon active">
                    <a data-action="add-override"
                        data-tooltip="COSMERE.Sheet.Advancement.Overrides.Add"
                    >
                        <i class="fa-solid fa-plus"></i>
                    </a>
                </div>
            </section>

            {{#each overrides as |override|}}
            <li class="item override">
                <section class="details">
                    <div class="detail">
                        {{#if ../editable}}
                        <input type="number" name="levels.min" value={{override.levels.min}}>
                        <input type="number" name="levels.max" value={{override.levels.max}}>
                        {{else}}
                        {{advancementOverrideLevels override.levels}}
                        {{/if}}
                    </div>
                    <div class="detail">
                        {{#if ../editable}}
                        <select name="type">
                            {{selectOptions override.options.type selected=override.type localize=true}}
                        </select>
                        {{else}}
                        {{localizeOverrideData override "type"}}
                        {{/if}}
                    </div>
                    <div class="detail">
                        {{#if ../editable}}
                        <select name="mode">
                            {{selectOptions override.options.mode selected=override.mode localize=true}}
                        </select>
                        {{else}}
                        {{localizeOverrideData override "mode"}}
                        {{/if}}
                    </div>
                    <div class="detail">
                        {{#if ../editable}}
                        <select name="key">
                            {{selectOptions override.options.key selected=override.key localize=true}}
                        </select>
                        {{else}}
                        {{localizeOverrideData override "key"}}
                        {{/if}}
                    </div>
                    <div class="detail">
                        {{#if ../editable}}
                        <select name="stat">
                            {{selectOptions override.options.stat selected=override.stat localize=true}}
                        </select>
                        {{else}}
                        {{localizeOverrideData override "stat"}}
                        {{/if}}
                    </div>
                    <div class="detail">
                        {{#if ../editable}}
                        <input type="number" name="value" value={{override.value}}>
                        {{else}}
                        {{override.value}}
                        {{/if}}
                    </div>
                    <div class="detail">
                        {{#if ../editable}}
                        <input type="number" name="priority" value={{override.priority}}>
                        {{else}}
                        {{override.priority}}
                        {{/if}}
                    </div>
                </section>
            </li>
            {{/each}}
        </li>
    </ul>
</div>