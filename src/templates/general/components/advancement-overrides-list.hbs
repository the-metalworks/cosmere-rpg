<ul class="item-list overrides">
    <li class="item header">
        <section class="details">
            <span class="subtitle wide"
                data-tooltip="COSMERE.Advancement.Override.Data.Levels.Description"
            >
                {{localize "COSMERE.Advancement.Override.Data.Levels.Label"}}
            </span>
            <span class="subtitle wide"
                data-tooltip="COSMERE.Advancement.Override.Data.Type.Description"
            >
                {{localize "COSMERE.Advancement.Override.Data.Type.Label"}}
            </span>
            <span class="subtitle wide"
                data-tooltip="COSMERE.Advancement.Override.Data.Mode.Description"
            >
                {{localize "COSMERE.Advancement.Override.Data.Mode.Label"}}
            </span>
            <span class="subtitle wide">
                {{localize "COSMERE.Advancement.Override.Data.Key.Label"}}
            </span>
            <span class="subtitle wide">
                {{localize "COSMERE.Advancement.Override.Data.Stat.Label"}}
            </span>
            <span class="subtitle">
                {{localize "COSMERE.Advancement.Override.Data.Value.Label"}}
            </span>
            <span class="subtitle"
                data-tooltip="COSMERE.Advancement.Override.Data.Priority.Description"
            >
                {{localize "COSMERE.Advancement.Override.Data.Priority.Label"}}
            </span>
            <div class="controls icon active">
                <a data-action="create-override"
                    data-tooltip="COSMERE.Sheet.Advancement.Overrides.Add"
                >
                    <i class="fa-solid fa-plus"></i>
                </a>
            </div>
        </section>
    </li>

    {{#each overrides as |override|}}
    <li class="item override" data-id="{{override.id}}">
        <section class="details">
            <div class="detail wide levels">
                {{#if ../editable}}
                <input class="override-input slim"
                    type="number"
                    name="levels.min"
                    value="{{override.levels.min}}"
                    placeholder={{localize "COSMERE.Advancement.Override.Data.Levels.Min.Label"}}
                    data-tooltip="COSMERE.Advancement.Override.Data.Levels.Min.Description"
                >
                -
                <input class="override-input slim"
                    type="number"
                    name="levels.max"
                    value="{{override.levels.max}}"
                    placeholder={{localize "COSMERE.Advancement.Override.Data.Levels.Max.Label"}}
                    data-tooltip="COSMERE.Advancement.Override.Data.Levels.Max.Description"
                >
                {{else}}
                {{advancementOverrideLevels override.levels}}
                {{/if}}
            </div>
            <div class="detail wide">
                {{#if ../editable}}
                <select class="override-input"
                    name="type"
                    data-tooltip="COSMERE.Advancement.Override.Type.{{override.type}}.Description"
                >
                    {{selectOptions override.options.type selected=override.type localize=true}}
                </select>
                {{else}}
                {{localizeOverrideData override "type"}}
                {{/if}}
            </div>
            <div class="detail wide">
                {{#if ../editable}}
                <select class="override-input"
                    name="mode"
                    data-tooltip="COSMERE.Advancement.Override.Mode.{{override.mode}}.Description"
                >
                    {{selectOptions override.options.mode selected=override.mode localize=true}}
                </select>
                {{else}}
                {{localizeOverrideData override "mode"}}
                {{/if}}
            </div>
            <div class="detail wide">
                {{#if ../editable}}
                <select class="override-input"
                    name="key"
                    data-tooltip="COSMERE.Advancement.Override.Field.{{override.type}}.{{override.key}}.Description"
                >
                    {{selectOptions override.options.key selected=override.key localize=true}}
                </select>
                {{else}}
                {{localizeOverrideData override "key"}}
                {{/if}}
            </div>
            <div class="detail wide">
                {{#if (eq override.type "max-stat")}}
                    {{#if ../editable}}
                    <select class="override-input"
                        name="stat"
                        {{#if (eq override.stat "base")}}
                        data-tooltip="COSMERE.Advancement.Override.Stat.base.Description"
                        {{/if}}
                    >
                        {{selectOptions override.options.stat selected=override.stat localize=true}}
                    </select>
                    {{else}}
                    {{localizeOverrideData override "stat"}}
                    {{/if}}
                {{/if}}
            </div>
            <div class="detail">
                {{#if ../editable}}
                <input class="override-input" type="text" name="value" value={{override.value}}>
                {{else}}
                {{override.value}}
                {{/if}}
            </div>
            <div class="detail">
                {{#if ../editable}}
                <input class="override-input" type="number" name="priority" value={{override.priority}}>
                {{else}}
                {{override.priority}}
                {{/if}}
            </div>
            <div class="controls">
                <a data-action="remove-override"
                    data-tooltip="GENERIC.Button.Remove"
                >
                    <i class="fa-solid fa-trash"></i>
                </a>
            </div>
        </section>
    </li>
    {{/each}}
</ul>