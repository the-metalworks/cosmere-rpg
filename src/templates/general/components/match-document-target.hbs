{{#if resolvedDocument}}

    <a class="content-link" data-link 
        data-uuid="{{resolvedDocument.uuid}}" 
        data-id="{{resolvedDocument.id}}" 
        data-type="{{resolvedDocument.documentName}}" 
        data-tooltip="{{localize (concat "DOCUMENT." resolvedDocument.documentName)}}"
    >
        {{#if resolvedDocument.img}}
            <img src="{{resolvedDocument.img}}" alt="{{resolvedDocument.name}}">
        {{/if}}

        <label>{{resolvedDocument.name}}</label>
    </a>

{{else}}

    <span class="target">{{localize (concat "COSMERE.Utils.MatchDocument.Target.Type." match.target)}}</span>

    {{!-- TODO: Localize --}}
    {{#if (eq match.matchBy "identifier")}}
        <span class="match-by">like</span>
    {{else if (eq match.matchBy "name")}}
        <span class="match-by">named</span>
    {{else if (eq match.matchBy "uuid")}}
        <span class="match-by">=</span>
    {{else if (eq match.matchBy "document-type")}}
        <span class="match-by">of type</span>
    {{/if}}

    {{#if (and (eq match.matchBy "document-type") match.documentType)}}
        <span class="type">{{localize (concat "DOCUMENT." match.documentType)}}</span>
    {{else if resolvedReference}}
        <a class="content-link" data-link 
            data-uuid="{{resolvedReference.uuid}}" 
            data-id="{{resolvedReference.id}}" 
            data-type="{{resolvedReference.documentName}}" 
            data-tooltip="{{localize (concat "DOCUMENT." resolvedReference.documentName)}}"
        >
            {{#if resolvedReference.img}}
                <img src="{{resolvedReference.img}}" alt="{{resolvedReference.name}}">
            {{/if}}

            <label>{{resolvedReference.name}}</label>
        </a>
    {{else}}
        <span>UNKNOWN</span>
    {{/if}}
{{/if}}