<div>    
    <fieldset>
        <legend>{{localize "DIALOG.PickDiceResult.Header"}} {{amountLeft}}</legend>
        <div class="dice-tooltip">        
            <div class="dice-rolls">
                {{#each results}}
                    <div class="roll {{classes}}"
                        data-index="{{index}}"
                        data-action="select-result"
                        data-tooltip="DIALOG.PickDiceResult.SelectRoll"
                    >
                        {{{result}}}
                    </div>
                {{/each}}
            </div>
        </div> 
    </fieldset> 
    <div class="form-group submit">
        <button data-action="submit" type="submit" {{#unless (eq amountLeft 0)}}disabled{{/unless}}>
            {{localize "GENERIC.Button.Confirm" }}
        </button>
    </div>
</div>
