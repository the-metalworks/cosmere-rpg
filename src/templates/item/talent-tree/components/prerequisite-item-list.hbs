<ul>
    {{#each items as |item|}}
    <li class="talent" data-id="{{item.id}}">
        <div class="col link">
            {{{item.link}}}
        </div>
        <div class="col controls">
            <a data-action="remove-item"
                data-tooltip="GENERIC.Button.Remove"
            >
                <i class="fa-solid fa-trash"></i>
            </a>
        </div>
    </li>
    {{/each}}
</ul>
<p>
    {{localize "COSMERE.Item.Sheet.Talent.Prerequisites.DropItems"}}
</p>