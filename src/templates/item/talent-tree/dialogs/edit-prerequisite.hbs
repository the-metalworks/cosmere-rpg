<form>
    {{!-- Type --}}
    <div class="form-group">
        <label>{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.Type"}}</label>
        <div class="form-fields">
            <select name="type">
                {{selectOptions typeSelectOptions selected=type localize=true}}
            </select>
        </div>
    </div>

    {{!-- Talent --}}
    {{#if (eq type "talent")}}
        <div class="form-group">
            {{app-node-prerequisite-item-list
                node=node
                items=talents
                type=type
            }}
        </div>
    {{/if}}

    {{!-- Goal --}}
    {{#if (eq type "goal")}}
        <div class="form-group">
            {{app-node-prerequisite-item-list
                node=node
                items=goals
                type=type
            }}
        </div>
    {{/if}}

    {{!-- Attribute --}}
    {{#if (eq type "attribute")}}
        {{#each attributes as |attribute|}}
        <fieldset>
            <div class="form-group">
                <label for="{{@root.dialogId}}-attributes-{{@index}}-key">{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.Attribute"}}</label>
                <div class="form-fields">
                    <select
                        id="{{@root.dialogId}}-attributes-{{@index}}-key"
                        name="attributes.{{@index}}.key"
                    >
                        {{selectOptions @root.attributeSelectOptions selected=attribute.key localize=true}}
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="{{@root.dialogId}}-attributes-{{@index}}-value">{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.AttributeValue"}}</label>
                <div class="form-fields">
                    <input
                        id="{{@root.dialogId}}-attributes-{{@index}}-value"
                        type="number"
                        name="attributes.{{@index}}.value"
                        value="{{attribute.value}}"
                        min="0"
                        step="1"
                        placeholder="{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.AttributeValuePlaceholder"}}"
                    >
                </div>
            </div>
            <button type="button" data-action="remove-enum-value" data-index="{{@index}}">
                {{localize "DIALOG.EditTalentPrerequisite.RemoveEnumValue"}}
            </button>
        </fieldset>
        {{/each}}
        <button type="button" data-action="add-enum-value" style="width: 100%;">+</button>
    {{/if}}

    {{!-- Skill --}}
    {{#if (eq type "skill")}}
        {{#each skills as |skill|}}
        <fieldset>
            <div class="form-group">
                <label for="{{@root.dialogId}}-skills-{{@index}}-key">{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.Skill"}}</label>
                <div class="form-fields">
                    <select
                        id="{{@root.dialogId}}-skills-{{@index}}-key"
                        name="skills.{{@index}}.key"
                    >
                        {{selectOptions @root.skillSelectOptions selected=skill.key localize=true}}
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="{{@root.dialogId}}-skills-{{@index}}-value">{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.SkillRank"}}</label>
                <div class="form-fields">
                    <input
                        id="{{@root.dialogId}}-skills-{{@index}}-value"
                        type="number"
                        name="skills.{{@index}}.value"
                        value="{{skill.value}}"
                        min="1"
                        step="1"
                        placeholder="{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.SkillRankPlaceholder"}}"
                    >
                </div>
            </div>
            <button type="button" data-action="remove-enum-value" data-index="{{@index}}">
                {{localize "DIALOG.EditTalentPrerequisite.RemoveEnumValue"}}
            </button>
        </fieldset>
        {{/each}}
        <button type="button" data-action="add-enum-value" style="width: 100%;">+</button>
    {{/if}}

    {{!-- Connection --}}
    {{#if (eq type "connection")}}
    <div class="form-group">
        <label>{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.ConnectionDescription"}}</label>
        <div class="form-fields">
            <input
                type="text"
                name="description"
                value="{{description}}"
                placeholder="{{localize "COSMERE.Item.Sheet.Talent.Prerequisites.ConnectionDescriptionPlaceholder"}}"
            >
        </div>
    </div>
    {{/if}}

    {{!-- Level --}}
    {{#if (eq type "level")}}
    {{formGroup schema.fields.level
        value=level
        name="level"
        localize=true
    }}
    {{/if}}

    {{!-- Ancestry --}}
    {{#if (eq type "ancestry")}}
        <div class="form-group">
            {{app-node-prerequisite-item-list
                node=node
                items=ancestries
                type=type
            }}
        </div>
    {{/if}}

    {{!-- Culture --}}
    {{#if (eq type "culture")}}
        <div class="form-group">
            {{app-node-prerequisite-item-list
                node=node
                items=cultures
                type=type
            }}
        </div>
    {{/if}}

    {{!-- Power --}}
    {{#if (eq type "power")}}
        <div class="form-group">
            {{app-node-prerequisite-item-list
                node=node
                items=powers
                type=type
            }}
        </div>
    {{/if}}

    {{!-- Submit --}}
    <br>
    <div class="form-group">
        <button data-action="update" type="submit">
            {{localize "GENERIC.Button.Update"}}
        </button>
    </div>
</form>
