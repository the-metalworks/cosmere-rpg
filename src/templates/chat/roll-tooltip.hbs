<section class="tooltip-part" data-uuid="{{uuid}}">
    <div class="dice">
        <ol class="dice-rolls">
            {{#each results}}
            <li class="roll {{classes}}" data-uuid="{{uuid}}">{{{result}}}</li>
            {{/each}}
        </ol>
        <div class="total">
            {{{icon}}}
            <span class="label">{{label}}</span>
            <span class="value">{{total}}</span>
        </div>
    </div>
</section>
