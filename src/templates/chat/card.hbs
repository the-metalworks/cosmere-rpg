<li class="chat-message message flexcol {{cssClass}}" data-message-id="{{message._id}}"
    {{#if borderColor}}style="border-color:{{borderColor}}"{{/if}}>
    <header class="message-header flexrow">
        <h4 class="message-sender">
            <a class="avatar" data-uuid="">
                <img src="{{speakerActor.img}}" alt="{{alias}}">
            </a>
            <span class="name-stacked">
                <span class="title">{{alias}}</span>
                <span class="subtitle">{{author.name}}</span>
            </span>
        </h4>
        <span class="message-metadata">
            <time class="message-timestamp">{{timeSince message.timestamp}}</time>
            {{#if canRepeat}}
            <a aria-label="{{localize 'COSMERE.ChatMessage.Repeat'}}" class="message-repeat" data-action="repeatMessage">
                <i class="fas fa-repeat"></i>
            </a>
            {{/if}}
            {{#if canDelete}}
            <a aria-label="{{localize 'COSMERE.ChatMessage.Delete'}}" class="message-delete" data-action="deleteMessage">
                <i class="fa-solid fa-trash" inert></i>
            </a>
            {{/if}}
            {{#if canClose}}
            <a aria-label="{{ localize "CHAT.Dismiss" }}" class="message-dismiss" data-action="dismissMessage">
                <i class="fa-solid fa-xmark" inert></i>
            </a>
            {{/if}}
        </span>

        {{#if isWhisper}}
        <span class="whisper-to">{{localize 'CHAT.To'}}: {{whisperTo}}</span>
        {{/if}}

        {{#if message.flavor}}
        <span class="flavor-text">{{{message.flavor}}}</span>
        {{/if}}
    </header>
    <div class="message-content">
        <div class="chat-card">
            {{{message.content}}}
        </div>
    </div>
</li>