<section class="chat-card-section description {{#if injury}}injury{{/if}} collapsible" {{#if uuid}}data-uuid="{{uuid}}"{{/if}}>
    <header class="summary">
        <img src="{{img}}">
        <div class="name-stacked">
            {{#if title}}
            <span class="title">{{{title}}}</span>
            {{/if}}
            {{#if subtitle}}
            <span class="subtitle">{{{subtitle}}}</span>
            {{else}}
                {{#if traits}}
                    <span class="traits">{{{traits}}}</span>
                {{/if}}
            {{/if}}
        </div>
        {{#if action}}
            <span class="icon cosmere-icon {{action}}"></span>
        {{/if}}
        {{#if apply}}
            <span class="icon clickable" data-action="apply" data-tooltip="{{localize "COSMERE.ChatMessage.Buttons.ApplyInjury"}}"><i class="fas fa-reply-all fa-flip-horizontal"></i></span>
        {{/if}}
    </header>
    {{#if description}}
    <section class="details collapsible-content">
        <div class="wrapper">
            {{{description}}}
        </div>
    </section>
    {{/if}}
</section>