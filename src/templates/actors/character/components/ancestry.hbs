{{#if hasAncestry}}
{{#with @root.visibility.limited as |limited|}}
    <div class="border-box">
        <div class="wrapper">
            <div class="details">
                <div class="title" {{#if (or @root.isObserver limited.ancestry)}}data-action="view"{{/if}}>        
                    <span class="name">
                        {{#if (or @root.isObserver limited.ancestry)}}
                            {{@root.ancestry.label}}            
                        {{else}}
                            {{localize "GENERIC.Unknown"}}
                        {{/if}}
                        {{#if isEditMode}}
                            <div class="controls">
                                <a data-action="remove"
                                    data-tooltip="GENERIC.Button.Remove"
                                >
                                    <i class="fa-solid fa-xmark"></i>
                                </a>
                            </div>
                        {{/if}}
                    </span>
                    <span class="item-type">{{localize "COSMERE.Item.Type.Ancestry.label"}}</span>        
                </div> 
            </div> 

            {{!-- Skills --}}
            
            {{#if (or @root.isObserver (and limited.ancestry limited.skills))}}
            {{#if (gt @root.ancestry.skills.length 0)}}
                <ul class="skill-list">
                    {{#each @root.ancestry.skills as |skill|}}
                        <li class="skill" data-id="{{skill.id}}">
                            {{app-actor-skill
                                skill=skill.id
                                readonly=(not @root.isEditMode)
                                pips=true
                            }}
                        </li>
                    {{/each}}
                </ul>
            {{/if}}
            {{/if}}
        </div>

        {{!-- Background image --}}
        {{#if (or @root.isObserver limited.ancestry)}}
        {{#if @root.ancestry.img}}
            <div class="background-img">
                <img src="{{@root.ancestry.img}}">
            </div>
        {{/if}}  
        {{/if}}  
    </div>    
    {{> box-corners }}    
{{/with}}
{{else}}
    <div class="ancestry drop-area">
        <span>{{localize "COSMERE.Actor.Sheet.AncestryPlaceholder"}}</span>
    </div>
{{/if}}