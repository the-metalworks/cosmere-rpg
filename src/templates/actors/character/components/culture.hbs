{{#if culture}}
{{#with @root.visibility.limited as |limited|}}
<div class="border-box">
    <div class="wrapper">
        {{!-- Details --}}
        <div class="details">
            <div class="title" {{#if (or @root.isObserver limited.culture)}}data-action="view"{{/if}}>    
                <span class="name">
                    {{#if (or @root.isObserver limited.culture)}}
                        {{@root.culture.label}}
                    {{else}}
                        {{localize "GENERIC.Unknown"}}
                    {{/if}}
                    {{#if isEditMode}}
                    <div class="controls">
                        <a data-action="remove"
                            data-tooltip="GENERIC.Button.Remove"
                        >
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    </div>
                    {{/if}}
                </span>
                <span class="item-type">{{localize "TYPES.Item.culture"}}</span>
            </div>
        </div>

        {{!-- Skills --}}
        {{#if (or @root.isObserver (and limited.culture limited.skills))}}
        {{#if (gt @root.skills.length 0)}}
            <ul class="skill-list">
                {{#each @root.skills as |skill|}}
                    <li class="skill" data-id="{{skill.id}}">
                        {{app-actor-skill
                            skill=skill.id
                            readonly=(not @root.isEditMode)
                            pips=true
                        }}
                    </li>
                {{/each}}
            </ul>
        {{/if}}
        {{/if}}
    </div>    

    {{!-- Background image --}}
    {{#if (or @root.isObserver limited.culture)}}
    {{#if @root.culture.img}}
        <div class="background-img">
            <img src="{{@root.culture.img}}">
        </div>
    {{/if}}
    {{/if}}
</div>    
{{> box-corners }}   
{{/with}}
{{else}}
    <div class="culture drop-area">
        <span>{{localize "COSMERE.Actor.Sheet.CulturePlaceholder"}}</span>
    </div>
{{/if}}