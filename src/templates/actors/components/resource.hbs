<div class="resource {{resource.id}}" data-id="{{resource.id}}">
    <div class="sidebar-header">
        <div>
            <span class="label">{{localize resource.label}}</span>
            {{#if isEditMode}}
            {{#if (eq resource.mode "range")}}
            {{#with resource.additionalContext.range as |range|}}
            <span class="range" style="font-size: x-small; color: var(--cosmere-color-accent);">
                ({{range.minRange}} - {{range.maxRange}})
            </span>
            <a role="button"
                data-action="roll-health"
                data-tooltip="COSMERE.Actor.Sheet.RollHealth"
            >
                <i class="fa-solid fa-dice"></i>
            </a>            
            {{#if (ne range.value range.average)}}
            <a role="button"
                data-action="clear-roll"
                data-tooltip="COSMERE.Actor.Sheet.ClearRoll"
            >
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </a>
            {{/if}}
            {{/with}}
            {{/if}}
            {{/if}}
        </div>

        <div class="controls">               
            {{#if (eq resource.id "hea")}} 
            <a role="button"
                data-action="roll-injury"
                data-tooltip="COSMERE.Actor.Sheet.RollInjury"
            >
                <i class="fa-solid fa-heart-pulse"></i>
            </a>
            {{/if}}
            {{#if isEditMode}}
            <a role="button"
                data-action="configure-resource"
                data-tooltip="{{localize "GENERIC.Configure"}} {{localize resource.label}}"
            >
                <i class="fa-solid fa-gear"></i>
            </a>
            {{/if}}
        </div>
    </div>
    <div class="sheet-stack bar {{#if editable}}editable{{/if}}" data-action="edit-value">
        <div class="container">            
            <div class="background"></div>
            <div class="inner">
                <div class="inner-bar" style="width: {{perc resource.value resource.max}};"></div>
            </div>
            <div class="border"></div>
            <div class="value">
                <span class="current">{{resource.value}}</span>
                <span class="delim">/</span>
                <span class="max">{{resource.max}}</span>
            </div>
            <input type="text" name="system.resources.{{resource.id}}.value" value="{{resource.value}}">            
        </div>
    </div>
</div>